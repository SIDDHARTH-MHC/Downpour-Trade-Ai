# Research platform (Phase 1+) — optional; production API still uses SQLite by default.

RESEARCH_DB_ENABLED=false
RESEARCH_DATABASE_URL=postgresql+psycopg://downpour:downpour@localhost:5433/downpour_research
RESEARCH_INTERNAL_API_ENABLED=false

# Research automation (attached to API BackgroundScheduler when uvicorn runs)
RESEARCH_SCHEDULER_ENABLED=false
RESEARCH_COLLECTOR_INTERVAL_HOURS=6
RESEARCH_COLLECTOR_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
RESEARCH_COLLECTOR_BARS=500
RESEARCH_DQ_HOUR_UTC=6
RESEARCH_WF_DAY_OF_WEEK=sun
RESEARCH_WF_HOUR_UTC=7
RESEARCH_WF_SYMBOLS=BTC/USDT,ETH/USDT
RESEARCH_WF_MONTHS=12

# Production calibration (SQLite trust buckets) — monthly via API scheduler
CALIBRATION_SCHEDULE_ENABLED=true
CALIBRATION_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
CALIBRATION_MONTHS=12
CALIBRATION_DAY_OF_MONTH=1
CALIBRATION_HOUR_UTC=3

# Promotion is never automatic — no env flag enables it.
